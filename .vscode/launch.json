{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current LeetCode File",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "--transpileOnly", "${file}"],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
