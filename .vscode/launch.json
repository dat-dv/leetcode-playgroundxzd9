{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current LeetCode File",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "${file}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug LeetCode by ID (npm run dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "${command:AskForChallengeID}"],
      "console": "integratedTerminal"
    }
  ]
}
