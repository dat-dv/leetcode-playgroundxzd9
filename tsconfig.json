{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"]
    },
    "moduleDetection": "force",
    "isolatedModules": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmitOnError": false,
    "sourceMap": true,
    "outDir": "out"
  },
  "include": ["scripts/run-dev.ts", "scripts/**/*", "leetcode/**/*"],
  "exclude": ["node_modules"]
}
